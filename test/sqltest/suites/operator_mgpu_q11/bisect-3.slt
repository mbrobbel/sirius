query ?? nosort
SELECT
  ps_partkey,
  SUM(ps_supplycost * ps_availqty) AS value
FROM
  read_parquet('__TEST_DIR__/partsupp/*.parquet') ps
  JOIN read_parquet('__TEST_DIR__/supplier/*.parquet') sup ON ps.ps_suppkey = sup.s_suppkey
  JOIN read_parquet('__TEST_DIR__/nation/*.parquet') n ON sup.s_nationkey = n.n_nationkey
WHERE
  n.n_name = 'GERMANY'
GROUP BY
  ps_partkey
HAVING
  SUM(ps_supplycost * ps_availqty) > (SELECT SUM(ps_supplycost * ps_availqty) * 0.00001 FROM read_parquet('__TEST_DIR__/partsupp/*.parquet') ps JOIN read_parquet('__TEST_DIR__/supplier/*.parquet') sup ON ps.ps_suppkey = sup.s_suppkey JOIN read_parquet('__TEST_DIR__/nation/*.parquet') n ON sup.s_nationkey = n.n_nationkey WHERE n.n_name = 'GERMANY') ORDER BY value DESC LIMIT 20;
