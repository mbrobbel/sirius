include ../../fixtures/clickbench.slt

# sirius: id = "clickbench/q39"
# sirius: tags = ["clickbench"]

query ?? nosort
SELECT URL, COUNT(*) AS PageViews FROM hits WHERE CounterID = 62 AND EventDate >= '2013-07-01' AND EventDate <= '2013-07-31' AND IsRefresh = 0 AND IsLink <> 0 AND IsDownload = 0 GROUP BY URL ORDER BY PageViews DESC, 1, 2 LIMIT 10 OFFSET 1000;
----
