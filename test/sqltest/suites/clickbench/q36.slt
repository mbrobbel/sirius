query ????? nosort
SELECT
  ClientIP,
  ClientIP - 1,
  ClientIP - 2,
  ClientIP - 3,
  COUNT(*) AS c
FROM
  hits
GROUP BY
  ClientIP, ClientIP - 1, ClientIP - 2, ClientIP - 3 ORDER BY c DESC, 1, 2, 3, 4, 5 LIMIT 10;
