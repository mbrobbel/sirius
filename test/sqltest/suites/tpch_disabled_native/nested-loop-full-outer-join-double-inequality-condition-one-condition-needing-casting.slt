SELECT
  n.n_nationkey,
  n.n_name,
  c.c_nationkey,
  c.c_custkey,
  c.c_name
FROM
  nation n
  FULL JOIN customer c ON n.n_nationkey > c.c_custkey AND n.n_nationkey <= c.c_nationkey
WHERE
  c.c_custkey < 1000 ORDER BY c.c_custkey, n.n_nationkey LIMIT 1000;
