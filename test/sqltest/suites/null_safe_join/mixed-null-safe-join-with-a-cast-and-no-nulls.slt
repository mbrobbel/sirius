SELECT
  mtl.id,
  mtr.id
FROM
  mtl
  JOIN mtr ON mtl.a = mtr.a AND mtl.b IS NOT DISTINCT FROM mtr.b
WHERE
  mtl.b IS NOT NULL AND mtr.b IS NOT NULL;
