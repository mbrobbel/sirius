# transparent S3 non-glob reads distinguish literal percent keys from spaces

# Original case: test/cpp/integration/test_s3_sql_surface.cpp:2672
# sirius: id = "s3_surface/percent-vs-space/001"
# sirius: snapshot = true
# sirius: tags = ["s3", "integration", "glob"]
query ? nosort
SELECT
  count(*)
FROM
  read_parquet('__OBJECT_ROOT__/glob-enc/f%20g.parquet') ORDER BY 1;
----
25

