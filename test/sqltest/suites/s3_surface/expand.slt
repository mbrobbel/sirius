query ??? nosort
SELECT
  n_nationkey,
  n_name,
  n_regionkey
FROM
  read_parquet('__OBJECT_ROOT__/glob/multi/nation_*.parquet') ORDER BY n_nationkey, n_name, n_regionkey;
