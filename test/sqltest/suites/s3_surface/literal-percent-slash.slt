# transparent S3 glob opens the literal percent key instead of its slash decoy

# Original case: test/cpp/integration/test_s3_sql_surface.cpp:2563
# sirius: id = "s3_surface/literal-percent-slash/001"
# sirius: snapshot = true
# sirius: tags = ["s3", "integration", "glob"]
query ?? nosort
SELECT
  n_nationkey,
  n_name
FROM
  read_parquet('__OBJECT_ROOT__/glob-enc/a*.parquet') ORDER BY n_nationkey, n_name;
