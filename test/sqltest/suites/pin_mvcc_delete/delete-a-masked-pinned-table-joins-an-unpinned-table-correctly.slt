# mvcc delete: a masked pinned table joins an unpinned table correctly
# Checkpoints are explicit so pin images and transaction snapshots remain intact.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k FROM range(100000);

statement ok
CREATE TABLE u AS SELECT range::INTEGER AS k, (range % 10)::INTEGER AS g FROM range(100000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
DELETE FROM
  t
WHERE
  k % 3 = 0;

# Original query: test/cpp/integration/test_pin_table_mvcc_delete.cpp:386
# sirius: id = "pin_mvcc_delete/delete-a-masked-pinned-table-joins-an-unpinned-table-correctly/001"
# sirius: tags = ["integration", "pin_table", "mvcc", "delete"]
query ?? rowsort
SELECT
  u.g,
  count(*)
FROM
  t
  JOIN u ON t.k = u.k
GROUP BY
  u.g ORDER BY u.g;
----

onlyif sirius
statement ok
CALL unpin_table('t');
