# mvcc insert: committed post-pin inserts serve from the cache plus the delta
# Checkpoints are explicit so pin images and transaction snapshots remain intact.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k FROM range(50000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
INSERT INTO t SELECT
  range::INTEGER + 50000
FROM
  range(100);

