# mvcc delete: a fully-deleted table serves an empty result
# Checkpoints are explicit so pin images and transaction snapshots remain intact.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k FROM range(50000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
DELETE FROM
  t;

# Original query: test/cpp/integration/test_pin_table_mvcc_delete.cpp:199
# sirius: id = "pin_mvcc_delete/delete-a-fully-deleted-table-serves-an-empty-result/001"
# sirius: tags = ["integration", "pin_table", "mvcc", "delete"]
# sirius: execution = "allow_fallback"
query ? rowsort
SELECT
  count(*)
FROM
  t;
----

# Original query: test/cpp/integration/test_pin_table_mvcc_delete.cpp:201
# sirius: id = "pin_mvcc_delete/delete-a-fully-deleted-table-serves-an-empty-result/002"
# sirius: tags = ["integration", "pin_table", "mvcc", "delete"]
query ? rowsort
SELECT
  count(k)
FROM
  t;
----

# Original query: test/cpp/integration/test_pin_table_mvcc_delete.cpp:202
# sirius: id = "pin_mvcc_delete/delete-a-fully-deleted-table-serves-an-empty-result/003"
# sirius: tags = ["integration", "pin_table", "mvcc", "delete"]
query ? rowsort
