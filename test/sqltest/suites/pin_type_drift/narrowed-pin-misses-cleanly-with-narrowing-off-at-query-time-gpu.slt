# pin_table type drift - narrowed pin misses cleanly with narrowing off at query time; tier = gpu.
# Pin narrowing and cache-serving counters remain asserted in C++.

onlyif sirius
statement ok
SET enable_compressed_materialization = true;

statement ok
CREATE TABLE drift_t AS SELECT (10000 + range)::INTEGER AS a FROM range(100);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 'drift_t', tier = 'gpu');

statement ok
DROP TABLE drift_t;

statement ok
CREATE TABLE drift_t AS SELECT DATE '2020-01-01' + range::INTEGER AS a FROM range(100);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
SET enable_compressed_materialization = false;

