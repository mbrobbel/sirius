# pin_table type drift - DATE pin recreated as INTEGER serves fresh integers; tier = host.
# Pin narrowing and cache-serving counters remain asserted in C++.

onlyif sirius
statement ok
SET enable_compressed_materialization = true;

statement ok
CREATE TABLE drift_t AS SELECT DATE '2020-01-01' + range::INTEGER AS a FROM range(100);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 'drift_t', tier = 'host');

statement ok
DROP TABLE drift_t;

statement ok
CREATE TABLE drift_t AS SELECT (5 + range)::INTEGER AS a FROM range(100);

statement ok
CHECKPOINT;

