# sirius: id = "s3_tpch_sf1/q18"
# sirius: snapshot = false
# sirius: tags = ["s3", "integration", "tpch"]
query ?????? rowsort
SELECT
  c.c_name,
  c.c_custkey,
  o.o_orderkey,
  o.o_orderdate,
  o.o_totalprice,
  sum(l.l_quantity)
FROM
  customer c,
  orders o,
  lineitem l
WHERE
  o.o_orderkey IN (SELECT l_orderkey FROM lineitem GROUP BY l_orderkey HAVING sum(l_quantity) > 300) AND c.c_custkey = o.o_custkey AND o.o_orderkey = l.l_orderkey
GROUP BY
  c.c_name, c.c_custkey, o.o_orderkey, o.o_orderdate, o.o_totalprice ORDER BY o.o_totalprice DESC, o.o_orderdate LIMIT 100;
