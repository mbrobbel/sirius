  ('Pull Ups', 5),
  ('Push Jerk', 5),
  ('Bar Muscle Up', 10),
  ('a', 10),
  ('b', 13),
  ('c', 15),
  ('d', 16);

statement ok
CREATE TABLE equipment (
  equip TEXT,
  difficulty_level INTEGER
);

statement ok
INSERT INTO equipment VALUES
  ('Board', 3),
  ('Weight', 5),
  ('Trampoline', 3),
  ('Horse', 12);

