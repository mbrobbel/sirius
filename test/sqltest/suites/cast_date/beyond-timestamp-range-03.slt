# DuckDB rejects the overflowing cast; Sirius answers by the date instant.
# Preserve the original explicit expected rows for this documented divergence.
include ../../fixtures/migrated/cast_date.slt

onlyif sirius
statement ok
SET pin_table_compression = true;

onlyif sirius
statement ok
SET pin_table_compression_min_batch_size_bytes = 0;

onlyif sirius
statement ok
SET pin_table_compression_max_compressed_fraction = 1000;

onlyif sirius
statement ok
SET pin_table_input_compression_plan_dir = '__TEST_DIR__';

onlyif sirius
statement ok
CALL pin_table('__TEST_DIR__/t_far.parquet', tier = 'gpu', name = 'p_t_far');

onlyif duckdb
statement error Conversion Error
SELECT id FROM p_t_far WHERE d < TIMESTAMP 'infinity';

onlyif duckdb
statement ok
CREATE VIEW expected_or_actual AS
SELECT
  id
FROM
  (
    VALUES
      (1),
      (2)
  ) AS values_table (id);

onlyif sirius
statement ok
CREATE VIEW expected_or_actual AS
SELECT
  id
FROM
  p_t_far
WHERE
  d < TIMESTAMP 'infinity';

# Original query: test/cpp/integration/test_gpu_execution_cast_date_predicates.cpp:353
# sirius: id = "cast_date/beyond-timestamp-range-03"
