CREATE VIEW tpch_q21 AS
SELECT
  s.s_name,
  count(*) AS numwait
FROM
  supplier s,
  lineitem l1,
  orders o,
  nation n
WHERE
  s.s_suppkey = l1.l_suppkey AND o.o_orderkey = l1.l_orderkey AND o.o_orderstatus = 'F' AND l1.l_receiptdate > l1.l_commitdate AND EXISTS (SELECT * FROM lineitem l2 WHERE l2.l_orderkey = l1.l_orderkey AND l2.l_suppkey <> l1.l_suppkey) AND NOT EXISTS (SELECT * FROM lineitem l3 WHERE l3.l_orderkey = l1.l_orderkey AND l3.l_suppkey <> l1.l_suppkey AND l3.l_receiptdate > l3.l_commitdate) AND s.s_nationkey = n.n_nationkey AND n.n_name = 'BRAZIL'
GROUP BY
  s.s_name ORDER BY numwait DESC, s.s_name;

