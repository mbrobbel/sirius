CREATE VIEW tpch_q12 AS
SELECT
  l.l_shipmode,
  sum(CASE WHEN o.o_orderpriority = '1-URGENT' OR o.o_orderpriority = '2-HIGH' THEN 1 ELSE 0 END) AS high_line_count,
  sum(CASE WHEN o.o_orderpriority <> '1-URGENT' AND o.o_orderpriority <> '2-HIGH' THEN 1 ELSE 0 END) AS low_line_count
FROM
  orders o,
  lineitem l
WHERE
  o.o_orderkey = l.l_orderkey AND l.l_shipmode IN ('TRUCK', 'REG AIR') AND l.l_commitdate < l.l_receiptdate AND l.l_shipdate < l.l_commitdate AND l.l_receiptdate >= DATE '1994-01-01' AND l.l_receiptdate < DATE '1995-01-01'
GROUP BY
  l.l_shipmode ORDER BY l.l_shipmode;

