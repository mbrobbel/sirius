query ?? rowsort
SELECT
  l_orderkey,
  CASE WHEN l_orderkey % 7 = 0 THEN NULL ELSE l_returnflag END || '-' || l_linestatus
FROM
  lineitem ORDER BY l_orderkey, l_linenumber LIMIT 100;
