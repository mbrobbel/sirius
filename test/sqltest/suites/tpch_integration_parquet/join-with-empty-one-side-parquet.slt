SELECT
  l.l_orderkey AS lokey,
  l.l_linestatus,
  o.o_custkey
FROM
  lineitem l
  INNER JOIN orders o ON l.l_orderkey = o.o_orderkey
WHERE
  l_linestatus = 'J';
