query ??? rowsort
SELECT
  l.l_orderkey,
  l.l_linestatus,
  o.o_custkey
FROM
  lineitem l
  INNER JOIN orders o ON l.l_orderkey = o.o_orderkey
WHERE
  l.l_orderkey > 10000 AND o.o_orderkey < 10000 ORDER BY l.l_orderkey, o.o_custkey;
