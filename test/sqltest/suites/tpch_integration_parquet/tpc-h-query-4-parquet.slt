# gpu_execution - TPC-H Query 4 parquet
include ../../fixtures/migrated/tpch-parquet-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:4188
# sirius: id = "tpch_integration_parquet/tpc-h-query-4-parquet/001"
# sirius: tags = ["integration", "tpch"]
query ?? rowsort
SELECT
  o.o_orderpriority,
  count(*) AS order_count
FROM
  orders o
WHERE
  o.o_orderdate >= DATE '1996-10-01' AND o.o_orderdate < DATE '1997-01-01' AND EXISTS (SELECT * FROM lineitem l WHERE l.l_orderkey = o.o_orderkey AND l.l_commitdate < l.l_receiptdate)
GROUP BY
  o.o_orderpriority ORDER BY o.o_orderpriority;
----
