query ?? rowsort
SELECT
  n.n_nationkey,
  n.n_regionkey
FROM
  nation n
  ANTI JOIN (SELECT c_custkey FROM customer WHERE c_custkey <= 25) c ON n.n_nationkey = c.c_custkey;
