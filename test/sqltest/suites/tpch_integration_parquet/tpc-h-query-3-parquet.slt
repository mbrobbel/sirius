# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:4158
# sirius: id = "tpch_integration_parquet/tpc-h-query-3-parquet/001"
# sirius: tags = ["integration", "tpch"]
query ???? rowsort
SELECT
  l.l_orderkey,
  sum(l.l_extendedprice * (1 - l.l_discount)) AS revenue,
  o.o_orderdate,
  o.o_shippriority
FROM
  customer c,
  orders o,
  lineitem l
WHERE
  c.c_mktsegment = 'HOUSEHOLD' AND c.c_custkey = o.o_custkey AND l.l_orderkey = o.o_orderkey AND o.o_orderdate < DATE '1995-03-25' AND l.l_shipdate > DATE '1995-03-25'
GROUP BY
  l.l_orderkey, o.o_orderdate, o.o_shippriority ORDER BY revenue DESC, o.o_orderdate LIMIT 10;
