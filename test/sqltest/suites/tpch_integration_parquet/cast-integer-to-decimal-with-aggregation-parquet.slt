# gpu_execution - cast integer to decimal with aggregation parquet
include ../../fixtures/migrated/tpch-parquet-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:3188
# sirius: id = "tpch_integration_parquet/cast-integer-to-decimal-with-aggregation-parquet/001"
