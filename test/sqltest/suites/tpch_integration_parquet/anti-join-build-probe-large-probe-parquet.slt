# sirius: tags = ["integration", "gpu_execution", "parquet", "antijoin"]
query ? rowsort
SELECT
  count(*) AS n
FROM
  orders o
  ANTI JOIN (SELECT c_custkey FROM customer WHERE c_nationkey < 3) c ON o.o_custkey = c.c_custkey;
