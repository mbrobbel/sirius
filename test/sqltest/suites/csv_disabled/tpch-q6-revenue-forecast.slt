# gpu_execution csv - tpch q6 revenue forecast
include ../../fixtures/migrated/csv.slt

# Original case: test/cpp/integration/test_gpu_execution_multi_format.cpp:560
# sirius: id = "csv_disabled/tpch-q6-revenue-forecast"
# sirius: tags = ["csv", "integration", "previously-disabled"]
# sirius: float_tolerance = { absolute = 0.01, relative = 0.0 }
query ? nosort
SELECT
  sum(l_extendedprice * l_discount) AS revenue
FROM
  lineitem
WHERE
  l_shipdate >= DATE '1997-01-01' AND l_shipdate < DATE '1998-01-01' AND l_discount BETWEEN 0.07 - 0.01 AND 0.07 + 0.01 AND l_quantity < 25;
----
