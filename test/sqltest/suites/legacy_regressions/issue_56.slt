include ../../fixtures/migrated/legacy_regressions/issue_56.slt

# Test IS NOT DISTINCT with string data
# sirius: id = "legacy_regressions/issue_56/01"
# sirius: tags = ["regression", "issue_56", "null", "is_not_distinct"]
# sirius: snapshot = true
query I rowsort
SELECT
  rowID
FROM
  issue_56
WHERE
  dataStringOne IS NOT DISTINCT FROM dataStringTwo;
----
1
2

# Test IS NOT DISTINCT with non-NULL constant string
# sirius: id = "legacy_regressions/issue_56/02"
# sirius: tags = ["regression", "issue_56", "null", "is_not_distinct"]
# sirius: snapshot = true
query I rowsort
SELECT
  rowID
FROM
  issue_56
WHERE
  'DEF' IS NOT DISTINCT FROM dataStringTwo;
----
3

# Test IS NOT DISTINCT with NULL compared to string
# sirius: id = "legacy_regressions/issue_56/03"
# sirius: tags = ["regression", "issue_56", "null", "is_not_distinct"]
# sirius: snapshot = true
query I rowsort
SELECT
  rowID
FROM
  issue_56
WHERE
  NULL IS NOT DISTINCT FROM dataStringTwo;
----
1
4

