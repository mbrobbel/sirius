# Invariant N holds across the suite's join shapes at the default threshold
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_dynamic_filter_native.cpp:209
# sirius: id = "dynamic_filter_native/invariant-n-holds-across-the-suite-s-join-shapes-at-the-default-threshold/001"
# sirius: tags = ["integration", "dynamic_filter", "tpch"]
query ? rowsort
SELECT
  count(*)
FROM
  lineitem
  JOIN (SELECT p_partkey FROM part WHERE p_partkey > 1 GROUP BY p_partkey) p ON l_partkey = p_partkey;
----

# Original query: test/cpp/integration/test_gpu_execution_dynamic_filter_native.cpp:210
# sirius: id = "dynamic_filter_native/invariant-n-holds-across-the-suite-s-join-shapes-at-the-default-threshold/002"
