# Original query: test/cpp/integration/test_gpu_execution_dynamic_filter_native.cpp:211
# sirius: id = "dynamic_filter_native/invariant-n-holds-across-the-suite-s-join-shapes-at-the-default-threshold/003"
# sirius: tags = ["integration", "dynamic_filter", "tpch"]
query ??? rowsort
SELECT
  count(*),
  min(l_orderkey),
  max(l_orderkey)
FROM
  lineitem
  JOIN part ON l_partkey = p_partkey
WHERE
  p_size = 15 AND p_container = 'SM BOX';
----

# Original query: test/cpp/integration/test_gpu_execution_dynamic_filter_native.cpp:215
# sirius: id = "dynamic_filter_native/invariant-n-holds-across-the-suite-s-join-shapes-at-the-default-threshold/004"
# sirius: tags = ["integration", "dynamic_filter", "tpch"]
query ?? rowsort
SELECT
  count(*),
  sum(l.l_orderkey)
FROM
  lineitem l
  JOIN (SELECT o_orderkey FROM orders WHERE o_orderkey / 100 = 50) o ON l.l_orderkey = o.o_orderkey;
