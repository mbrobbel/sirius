query ? rowsort
SELECT
  count(*)
FROM
  lineitem
  JOIN (SELECT p_partkey FROM part WHERE p_size = 15 AND p_container = 'SM BOX' GROUP BY p_partkey) p ON l_partkey = p_partkey;
