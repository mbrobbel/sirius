include ../../fixtures/migrated/tpch-sf10.slt

# sirius: id = "tpch_sf10/q06"
# sirius: tags = ["integration", "tpch", "sf10", "multi_gpu"]
# sirius: float_tolerance = { absolute = 0.0001, relative = 0.0 }
query ? rowsort
SELECT
  sum(l_extendedprice * l_discount) AS revenue
FROM
  lineitem
WHERE
  l_shipdate >= DATE '1995-01-01' AND l_shipdate < DATE '1996-01-01' AND l_discount BETWEEN 0.07 - 0.01 AND 0.07 + 0.01 AND l_quantity < 24;
----
