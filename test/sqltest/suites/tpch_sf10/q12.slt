# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:4530
include ../../fixtures/migrated/tpch-sf10.slt

# sirius: id = "tpch_sf10/q12"
# sirius: tags = ["integration", "tpch", "sf10", "multi_gpu"]
query ??? rowsort
SELECT
  l_shipmode,
  sum(CASE WHEN o_orderpriority = '1-URGENT' OR o_orderpriority = '2-HIGH' THEN 1 ELSE 0 END) AS high_line_count,
  sum(CASE WHEN o_orderpriority <> '1-URGENT' AND o_orderpriority <> '2-HIGH' THEN 1 ELSE 0 END) AS low_line_count
FROM
  orders,
  lineitem
WHERE
  o_orderkey = l_orderkey AND l_shipmode IN ('SHIP', 'AIR') AND l_commitdate < l_receiptdate AND l_shipdate < l_commitdate AND l_receiptdate >= DATE '1995-01-01' AND l_receiptdate < DATE '1996-01-01'
GROUP BY
  l_shipmode ORDER BY l_shipmode;
----
