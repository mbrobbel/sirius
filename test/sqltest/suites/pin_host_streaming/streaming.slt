statement ok
COPY (SELECT range AS k, range * 2 AS v FROM range(40000000)) TO '__TEST_DIR__/wide.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW t AS
SELECT
  *
FROM
  read_parquet('__TEST_DIR__/wide.parquet');

onlyif sirius
statement ok
CALL pin_table('__TEST_DIR__/wide.parquet', tier = 'host', name = 't');

