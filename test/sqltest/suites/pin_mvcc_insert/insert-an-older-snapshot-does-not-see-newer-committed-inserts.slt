# mvcc insert: an older snapshot does not see newer committed inserts
# Checkpoints are explicit to preserve base, transient, and persistent delta storage.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k FROM range(50000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

connection reader
statement ok
BEGIN TRANSACTION;

connection reader
statement ok
SELECT
  count(*)
FROM
  t;

statement ok
INSERT INTO t SELECT
  range::INTEGER + 50000
FROM
  range(500);

