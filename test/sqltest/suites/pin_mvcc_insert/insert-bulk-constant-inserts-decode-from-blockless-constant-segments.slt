# mvcc insert: bulk constant inserts decode from blockless CONSTANT segments
# Checkpoints are explicit to preserve base, transient, and persistent delta storage.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k, range::INTEGER AS v FROM range(20000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
INSERT INTO t SELECT
  range::INTEGER + 20000,
  7
FROM
  range(130000);

