# mvcc insert: bulk inserts ride the persistent MergeStorage lane
# Checkpoints are explicit to preserve base, transient, and persistent delta storage.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k FROM range(50000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
INSERT INTO t SELECT
  range::INTEGER + 50000
FROM
  range(130000);

statement ok
INSERT INTO t VALUES
  (180000);

# Original query: test/cpp/integration/test_pin_table_mvcc_insert.cpp:180
# sirius: id = "pin_mvcc_insert/insert-bulk-inserts-ride-the-persistent-mergestorage-lane/001"
# sirius: tags = ["integration", "pin_table", "mvcc", "insert"]
query ??? rowsort
SELECT
  count(*),
  max(k),
  sum(k)
FROM
  t;
----

# Original query: test/cpp/integration/test_pin_table_mvcc_insert.cpp:181
# sirius: id = "pin_mvcc_insert/insert-bulk-inserts-ride-the-persistent-mergestorage-lane/002"
# sirius: tags = ["integration", "pin_table", "mvcc", "insert"]
query ? rowsort
SELECT
  count(*)
FROM
  t
WHERE
  k >= 100000;
