# mvcc insert: base deletes and post-pin inserts combine in one query
# Checkpoints are explicit to preserve base, transient, and persistent delta storage.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k, (range * 2)::INTEGER AS v FROM range(200000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
DELETE FROM
  t
WHERE
  k % 1000 = 7;

statement ok
INSERT INTO t SELECT
  range::INTEGER + 200000,
  0
FROM
  range(3000);

statement ok
DELETE FROM
  t
WHERE
  k >= 202000;

# Original query: test/cpp/integration/test_pin_table_mvcc_insert.cpp:161
# sirius: id = "pin_mvcc_insert/insert-base-deletes-and-post-pin-inserts-combine-in-one-query/001"
# sirius: tags = ["integration", "pin_table", "mvcc", "insert"]
query ??? rowsort
SELECT
  count(*),
  sum(k),
  sum(v)
FROM
  t;
----

# Original query: test/cpp/integration/test_pin_table_mvcc_insert.cpp:162
# sirius: id = "pin_mvcc_insert/insert-base-deletes-and-post-pin-inserts-combine-in-one-query/002"
# sirius: tags = ["integration", "pin_table", "mvcc", "insert"]
query ?? rowsort
SELECT
  k,
  v
FROM
  t
WHERE
  k > 199990 ORDER BY k;
----

onlyif sirius
statement ok
CALL unpin_table('t');
