# mvcc insert: appends into an indexed tail row group keep per-segment constants
# Checkpoints are explicit to preserve base, transient, and persistent delta storage.

statement ok
CREATE TABLE t (
  k INTEGER PRIMARY KEY,
  v INTEGER
);

statement ok
INSERT INTO t SELECT
  range::INTEGER,
  range::INTEGER
FROM
  range(20000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
INSERT INTO t SELECT
  range::INTEGER + 20000,
  9
FROM
  range(130000);

statement ok
INSERT INTO t VALUES
  (150001, 7);

