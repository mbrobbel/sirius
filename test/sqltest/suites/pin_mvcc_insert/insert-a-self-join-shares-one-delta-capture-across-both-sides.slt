# mvcc insert: a self-join shares one delta capture across both sides
# Checkpoints are explicit to preserve base, transient, and persistent delta storage.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k, (range % 100)::INTEGER AS g FROM range(60000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
INSERT INTO t SELECT
  range::INTEGER + 60000,
  7
FROM
  range(300);

# Original query: test/cpp/integration/test_pin_table_mvcc_insert.cpp:333
# sirius: id = "pin_mvcc_insert/insert-a-self-join-shares-one-delta-capture-across-both-sides/001"
# sirius: tags = ["integration", "pin_table", "mvcc", "insert"]
query ?? rowsort
SELECT
  a.g,
  count(*)
FROM
  t a
  JOIN t b ON a.k = b.k
GROUP BY
  a.g ORDER BY a.g;
----

onlyif sirius
statement ok
CALL unpin_table('t');
