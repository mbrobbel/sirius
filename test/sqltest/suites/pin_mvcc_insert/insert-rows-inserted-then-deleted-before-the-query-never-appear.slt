# mvcc insert: rows inserted then deleted before the query never appear
# Checkpoints are explicit to preserve base, transient, and persistent delta storage.

statement ok
CREATE TABLE t AS SELECT range::INTEGER AS k FROM range(50000);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
CALL pin_table(format = 'duckdb', name = 't', tier = 'gpu');

statement ok
INSERT INTO t SELECT
  range::INTEGER + 50000
FROM
  range(200);

statement ok
DELETE FROM
  t
WHERE
  k >= 50100;

# Original query: test/cpp/integration/test_pin_table_mvcc_insert.cpp:118
# sirius: id = "pin_mvcc_insert/insert-rows-inserted-then-deleted-before-the-query-never-appear/001"
# sirius: tags = ["integration", "pin_table", "mvcc", "insert"]
query ??? rowsort
SELECT
  count(*),
  max(k),
  sum(k)
FROM
  t;
----

# Original query: test/cpp/integration/test_pin_table_mvcc_insert.cpp:119
# sirius: id = "pin_mvcc_insert/insert-rows-inserted-then-deleted-before-the-query-never-appear/002"
# sirius: tags = ["integration", "pin_table", "mvcc", "insert"]
query ? rowsort
SELECT
  k
FROM
  t
WHERE
  k >= 49990 ORDER BY k;
----

onlyif sirius
statement ok
CALL unpin_table('t');
