onlyif duckdb
statement ok
CREATE OR REPLACE VIEW search_result AS
SELECT
  id
FROM
  vs_enn_cos ORDER BY array_cosine_distance(vec, [1.0, 0.0, 0.0]::FLOAT[3]) LIMIT 5;

onlyif sirius
statement ok
CREATE OR REPLACE VIEW search_result AS
SELECT
  id
FROM
  sirius_knn_search('vs_enn_cos', 'vec', [1.0, 0.0, 0.0]::FLOAT[3], k => 5, output_columns => ['id'], metric => 'cosine', use_index => false);

