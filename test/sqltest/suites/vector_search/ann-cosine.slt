CREATE TABLE vs_cos AS SELECT i AS id, [sin(0.3 + i * 0.0013) * cos(i * 2.39996323), sin(0.3 + i * 0.0013) * sin(i * 2.39996323), cos(0.3 + i * 0.0013)]::FLOAT[3] AS vec FROM range(2000) t (i);

statement ok
CHECKPOINT;

onlyif sirius
statement ok
SELECT
  *
FROM
  pin_table(name => 'vs_cos', tier => 'gpu', format => 'duckdb');

onlyif sirius
statement ok
SELECT
  *
FROM
  sirius_create_ann_index('vs_cos', 'vec', metric => 'cosine', n_lists => 16);

onlyif duckdb
statement ok
CREATE OR REPLACE VIEW search_result AS
SELECT
  id
FROM
  vs_cos ORDER BY array_cosine_distance(vec, [0.0, 0.0, 1.0]::FLOAT[3]) LIMIT 1;

onlyif sirius
statement ok
