CREATE OR REPLACE VIEW search_result AS
SELECT
  array_distance(vec, [0.0, 0.0, 0.0]::FLOAT[3]) AS distance
FROM
  vs_probe ORDER BY array_distance(vec, [0.0, 0.0, 0.0]::FLOAT[3]) LIMIT 10;

onlyif sirius
statement ok
CREATE OR REPLACE VIEW search_result AS
SELECT
  distance
FROM
  sirius_knn_search('vs_probe', 'vec', [0.0, 0.0, 0.0]::FLOAT[3], k => 10, output_columns => ['id']) ORDER BY distance;

# Original query: test/cpp/integration/test_gpu_execution_vector_search.cpp:257
