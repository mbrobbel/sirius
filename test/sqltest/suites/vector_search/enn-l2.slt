CREATE OR REPLACE VIEW search_result AS
SELECT
  array_distance(vec, [2990.0, 2990.0, 2990.0]::FLOAT[3]) AS distance
FROM
  vs_enn ORDER BY array_distance(vec, [2990.0, 2990.0, 2990.0]::FLOAT[3]) LIMIT 15;

onlyif sirius
statement ok
CREATE OR REPLACE VIEW search_result AS
SELECT
  distance
FROM
  sirius_knn_search('vs_enn', 'vec', [2990.0, 2990.0, 2990.0]::FLOAT[3], k => 15, output_columns => ['id'], use_index => false) ORDER BY distance;

