SELECT
  n.n_nationkey,
  n.n_name,
  c.c_nationkey,
  c.c_custkey,
  c.c_name
FROM
  nation n
  JOIN customer c ON n.n_nationkey < c.c_nationkey * 2 AND n.n_regionkey * 1000 > c.c_custkey ORDER BY c.c_custkey, n.n_nationkey LIMIT 1000;
