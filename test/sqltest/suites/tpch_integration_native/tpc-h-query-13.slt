# gpu_execution - TPC-H Query 13
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:4317
# sirius: id = "tpch_integration_native/tpc-h-query-13/001"
# sirius: tags = ["integration", "tpch"]
query ?? rowsort
SELECT
  c_count,
  count(*) AS custdist
FROM
  (
    SELECT
      c.c_custkey,
      count(o.o_orderkey)
    FROM
      customer c
      LEFT OUTER JOIN orders o ON c.c_custkey = o.o_custkey AND o.o_comment NOT LIKE '%special%requests%'
    GROUP BY
      c.c_custkey
  ) AS orders (c_custkey, c_count)
GROUP BY
  c_count ORDER BY custdist DESC, c_count DESC;
----
