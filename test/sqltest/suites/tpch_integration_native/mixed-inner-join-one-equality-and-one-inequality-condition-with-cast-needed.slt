SELECT
  n.n_nationkey,
  n.n_name,
  c.c_nationkey,
  c.c_custkey,
  c.c_name
FROM
  nation n
  JOIN customer c ON n.n_nationkey = c.c_nationkey AND n.n_regionkey < c.c_custkey
WHERE
  c.c_custkey < 10000 ORDER BY c.c_custkey, n.n_nationkey LIMIT 1000;
