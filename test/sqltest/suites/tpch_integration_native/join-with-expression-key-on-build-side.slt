# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:860
# sirius: id = "tpch_integration_native/join-with-expression-key-on-build-side/001"
# sirius: tags = ["integration", "gpu_execution", "join"]
query ?? rowsort
SELECT
  n.n_nationkey,
  c.c_custkey
FROM
  customer c
  JOIN nation n ON c.c_custkey = n.n_nationkey * 10;
