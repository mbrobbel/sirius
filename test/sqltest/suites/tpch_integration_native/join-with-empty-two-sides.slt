query ??? rowsort
SELECT
  l.l_orderkey,
  l.l_linestatus,
  o.o_custkey AS ockey
FROM
  lineitem l
  INNER JOIN orders o ON l.l_orderkey = o.o_orderkey
WHERE
  l_linestatus = 'J' AND o.o_comment = 'Special';
