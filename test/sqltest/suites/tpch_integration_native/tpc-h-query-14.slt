# gpu_execution - TPC-H Query 14
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:4331
# sirius: id = "tpch_integration_native/tpc-h-query-14/001"
# sirius: tags = ["integration", "tpch"]
query ? rowsort
SELECT
  100.00 * sum(CASE WHEN p.p_type LIKE 'PROMO%' THEN l.l_extendedprice * (1 - l.l_discount) ELSE 0 END) / sum(l.l_extendedprice * (1 - l.l_discount)) AS promo_revenue
FROM
  lineitem l,
  part p
WHERE
  l.l_partkey = p.p_partkey AND l.l_shipdate >= DATE '1994-08-01' AND l.l_shipdate < DATE '1994-09-01';
----
