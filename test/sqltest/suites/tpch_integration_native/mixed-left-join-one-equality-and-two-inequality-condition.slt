# gpu_execution - mixed left join one equality and two inequality condition
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:2642
# sirius: id = "tpch_integration_native/mixed-left-join-one-equality-and-two-inequality-condition/001"
# sirius: tags = ["integration", "gpu_execution", "mixed_join"]
query ??? rowsort
SELECT
  ps.ps_partkey,
  ps.ps_suppkey,
  l.l_orderkey
FROM
  lineitem l
  LEFT JOIN partsupp ps ON l.l_partkey = ps.ps_partkey AND l.l_suppkey > ps.ps_suppkey AND l.l_orderkey < ps.ps_suppkey
WHERE
  l.l_orderkey < 1000 AND ps.ps_partkey < 1000 ORDER BY ps.ps_partkey, ps.ps_suppkey, l.l_orderkey LIMIT 1000;
