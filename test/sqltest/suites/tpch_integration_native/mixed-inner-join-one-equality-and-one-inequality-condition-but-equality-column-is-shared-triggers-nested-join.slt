query ??? rowsort
SELECT
  ps.ps_partkey,
  ps.ps_suppkey,
  l.l_orderkey
FROM
  lineitem l
  RIGHT JOIN partsupp ps ON l.l_partkey = ps.ps_partkey AND l.l_suppkey > ps.ps_partkey
WHERE
  l.l_orderkey < 1000 AND ps.ps_partkey < 1000 ORDER BY ps.ps_partkey, ps.ps_suppkey, l.l_orderkey LIMIT 1000;
