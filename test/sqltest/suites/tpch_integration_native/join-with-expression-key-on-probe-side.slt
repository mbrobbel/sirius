# gpu_execution - join with expression key on probe side
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:869
# sirius: id = "tpch_integration_native/join-with-expression-key-on-probe-side/001"
# sirius: tags = ["integration", "gpu_execution", "join"]
query ?? rowsort
SELECT
  n.n_nationkey,
  c.c_custkey
FROM
  customer c
  JOIN nation n ON c.c_nationkey * 2 = n.n_nationkey;
