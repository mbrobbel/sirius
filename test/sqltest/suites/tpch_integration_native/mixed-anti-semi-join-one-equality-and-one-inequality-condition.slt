# gpu_execution - mixed anti semi join one equality and one inequality condition
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:2699
# sirius: id = "tpch_integration_native/mixed-anti-semi-join-one-equality-and-one-inequality-condition/001"
# sirius: tags = ["integration", "gpu_execution", "mixed_join"]
query ?? rowsort
SELECT
  ps.ps_partkey,
  ps.ps_suppkey
FROM
  partsupp ps
  ANTI JOIN lineitem l ON l.l_partkey = ps.ps_partkey AND l.l_suppkey > ps.ps_suppkey
WHERE
  ps.ps_partkey < 1000 ORDER BY ps.ps_partkey, ps.ps_suppkey LIMIT 1000;
----
