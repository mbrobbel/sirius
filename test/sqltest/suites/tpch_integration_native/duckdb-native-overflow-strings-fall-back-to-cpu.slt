# sirius: tags = ["integration", "tpch", "fallback"]
# sirius: execution = "allow_fallback"
# sirius: snapshot = true
query II nosort
SELECT
  max(length(s)),
  count(*)
FROM
  ovf.main.bigstr;
----
5000	1000

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:5027
# sirius: id = "tpch_integration_native/duckdb-native-overflow-strings-fall-back-to-cpu/002"
# sirius: tags = ["integration", "tpch", "fallback"]
