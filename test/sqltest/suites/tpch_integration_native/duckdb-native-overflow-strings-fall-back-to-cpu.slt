# gpu_execution - duckdb-native overflow strings fall back to CPU
include ../../fixtures/migrated/tpch-native-original.slt

statement ok
ATTACH '__TEST_DIR__/overflow.duckdb' AS ovf;

statement ok
CREATE TABLE ovf.main.bigstr AS SELECT range AS id, CASE WHEN range = 7 THEN repeat('x', 5000) ELSE 'short_' || range END AS s FROM range(0, 1000);

statement ok
CHECKPOINT ovf;

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:5027
