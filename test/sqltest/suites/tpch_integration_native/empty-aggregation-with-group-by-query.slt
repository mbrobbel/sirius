SELECT
  l_linestatus,
  count(*),
  min(l_orderkey) AS mino,
  sum(l_orderkey),
  count(l_orderkey),
  count(l_receiptdate),
  min(l_receiptdate),
  count(l_comment),
  min(l_comment)
FROM
  lineitem
WHERE
  l_linestatus = 'J'
GROUP BY
  l_linestatus;
