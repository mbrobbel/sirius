# gpu_execution - mixed semi join one equality and one inequality condition
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:2666
# sirius: id = "tpch_integration_native/mixed-semi-join-one-equality-and-one-inequality-condition/001"
# sirius: tags = ["integration", "gpu_execution", "mixed_join"]
query ?? rowsort
SELECT
  l.l_orderkey,
  l.l_linenumber
FROM
  lineitem l
  SEMI JOIN partsupp ps ON l.l_partkey = ps.ps_partkey AND l.l_suppkey > ps.ps_suppkey
WHERE
  l.l_orderkey < 1000 ORDER BY l.l_orderkey, l.l_linenumber LIMIT 1000;
----
