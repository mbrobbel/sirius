# gpu_execution - join with expressions on both sides
include ../../fixtures/migrated/tpch-native-original.slt

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:878
# sirius: id = "tpch_integration_native/join-with-expressions-on-both-sides/001"
# sirius: tags = ["integration", "gpu_execution", "join"]
query ?? rowsort
SELECT
  n.n_nationkey,
  c.c_custkey
FROM
  customer c
  JOIN nation n ON c.c_nationkey * 10 = n.n_nationkey * 10;
