statement ok
COPY (SELECT range AS k, range * 2 AS v FROM range(4000000) ORDER BY k) TO '__TEST_DIR__/clustered.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW t AS
SELECT
  *
FROM
  read_parquet('__TEST_DIR__/clustered.parquet');

onlyif sirius
statement ok
SET enable_pinned_zone_map_pruning = false;

onlyif sirius
statement ok
CALL pin_table('__TEST_DIR__/clustered.parquet', tier = 'gpu', name = 't');

onlyif sirius
statement ok
SET enable_pinned_zone_map_pruning = true;

