# Source and license: ../../upstream/README.md
include ../../fixtures/tpch.slt

# sirius: id = "tpch/q14"
# sirius: tags = ["tpch"]
# sirius: tolerances = { "0" = { absolute = 1e-8, relative = 1e-9 } }

query ? rowsort
SELECT
  100.00 * sum(CASE WHEN p_type LIKE 'PROMO%' THEN l_extendedprice * (1 - l_discount) ELSE 0 END) / sum(l_extendedprice * (1 - l_discount)) AS promo_revenue
FROM
  lineitem,
  part
WHERE
  l_partkey = p_partkey AND l_shipdate >= DATE '1995-09-01' AND l_shipdate < CAST('1995-10-01' AS DATE);
----
