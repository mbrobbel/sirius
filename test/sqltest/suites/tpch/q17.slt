include ../../fixtures/tpch.slt

# sirius: id = "tpch/q17"
# sirius: tags = ["tpch"]
# sirius: tolerances = { "0" = { absolute = 1e-8, relative = 1e-9 } }

query ? rowsort
SELECT
  sum(l_extendedprice) / 7.0 AS avg_yearly
FROM
  lineitem,
  part
WHERE
  p_partkey = l_partkey AND p_brand = 'Brand#23' AND p_container = 'MED BOX' AND l_quantity < (SELECT 0.2 * avg(l_quantity) FROM lineitem WHERE l_partkey = p_partkey);
----
