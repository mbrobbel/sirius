# Original query: test/cpp/integration/test_gpu_execution_dynamic_filter_sip.cpp:351
# sirius: id = "dynamic_filter_sip/tpc-h-q17-a-delim-scan-build-wires-only-through-opaque-build-evidence/001-off"
# sirius: tags = ["integration", "dynamic_filter", "sip"]
query ? rowsort
SELECT
  sum(l.l_extendedprice) / 7.0 AS avg_yearly
FROM
  lineitem l,
  part p
WHERE
  p.p_partkey = l.l_partkey AND p.p_brand = 'Brand#13' AND p.p_container = 'JUMBO CAN' AND l.l_quantity < (SELECT 0.2 * avg(l2.l_quantity) FROM lineitem l2 WHERE l2.l_partkey = p.p_partkey);
