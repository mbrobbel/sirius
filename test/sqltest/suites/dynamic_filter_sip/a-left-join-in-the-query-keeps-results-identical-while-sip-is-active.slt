# a LEFT join in the query keeps results identical while SIP is active
include ../../fixtures/migrated/tpch-native-original.slt

statement ok
SET disabled_optimizers = concat_ws(',', nullif(current_setting('disabled_optimizers'), ''), 'statistics_propagation,join_order,build_side_probe_side');

onlyif sirius
statement ok
SET dynamic_filter_domain_coverage_threshold = 2.0;

onlyif sirius
statement ok
SET enable_dynamic_filter = false;

# Original query: test/cpp/integration/test_gpu_execution_dynamic_filter_sip.cpp:168
# sirius: id = "dynamic_filter_sip/a-left-join-in-the-query-keeps-results-identical-while-sip-is-active/001-off"
# sirius: tags = ["integration", "dynamic_filter", "sip"]
query ?? rowsort
SELECT
  count(*),
  sum(o.o_custkey)
FROM
  lineitem l
  LEFT JOIN orders o ON l.l_orderkey = o.o_orderkey
  JOIN customer c ON o.o_custkey = c.c_custkey
WHERE
  c.c_nationkey = 3;
----

onlyif sirius
statement ok
SET enable_dynamic_filter = true;

