SELECT
  count(*)
FROM
  orders o
  JOIN (SELECT l_orderkey, l_shipdate FROM lineitem WHERE l_shipdate < DATE '1992-02-01') l ON o.o_orderkey = l.l_orderkey AND o.o_orderdate < l.l_shipdate;
