# parquet nulls — filter on nullable numeric column
include ../../fixtures/migrated/parquet_nulls/ParquetDictNullFixture.slt

# Original query: test/cpp/integration/test_gpu_execution_parquet_nulls.cpp:942
# sirius: id = "parquet_nulls/filter-on-nullable-numeric-column/001"
# sirius: tags = ["integration", "parquet", "nulls"]
query ?? rowsort
SELECT
  id,
  val
FROM
  read_parquet('__TEST_DIR__/dict_nulls.parquet')
WHERE
  val > 50 ORDER BY id;
----

# Original query: test/cpp/integration/test_gpu_execution_parquet_nulls.cpp:944
# sirius: id = "parquet_nulls/filter-on-nullable-numeric-column/002"
# sirius: tags = ["integration", "parquet", "nulls"]
query ? rowsort
SELECT
  id
FROM
  read_parquet('__TEST_DIR__/dict_nulls.parquet')
WHERE
  val IS NOT DISTINCT FROM NULL ORDER BY id;
