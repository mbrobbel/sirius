# Original query: test/cpp/integration/test_gpu_execution_dense_count_join.cpp:94
# sirius: id = "dense_count_join/full-q13-distribution-shape-with-order-by/001"
# sirius: snapshot = true
# sirius: tags = ["integration", "dense_count_join"]
query ?? nosort
SELECT
  c_count,
  count(*) AS custdist
FROM
  (
    SELECT
      c_id,
      count(o_id) AS c_count
    FROM
      cust
      LEFT JOIN ord ON c_id = o_cust
    GROUP BY
      c_id
  ) t
GROUP BY
  c_count ORDER BY custdist DESC, c_count DESC;
