SELECT
  c_id,
  count(o.o_id) AS c_count
FROM
  cust
  LEFT JOIN (SELECT o1.o_id, o1.o_cust FROM ord o1 JOIN ord o2 ON o1.o_cust = o2.o_cust WHERE o1.o_val > 1000000) o ON c_id = o.o_cust
GROUP BY
  c_id;
