# Original query: test/cpp/integration/test_gpu_execution_dense_count_join.cpp:178
# sirius: id = "dense_count_join/nested-hash-join-on-the-preserved-side/001-fused"
# sirius: snapshot = true
# sirius: tags = ["integration", "dense_count_join"]
query ?? rowsort
SELECT
  c.c_id,
  count(o_id) AS c_count
FROM
  (
    SELECT
      c1.c_id
    FROM
      cust c1
      JOIN cust c2 ON c1.c_grp = c2.c_grp
  ) c
  LEFT JOIN ord ON c.c_id = o_cust
GROUP BY
  c.c_id;
