# sirius: id = "s3_tpch/q10"
# sirius: snapshot = true
# sirius: tags = ["s3", "integration", "tpch"]
query ???????? rowsort
SELECT
  c.c_custkey,
  c.c_name,
  sum(l.l_extendedprice * (1 - l.l_discount)) AS revenue,
  c.c_acctbal,
  n.n_name,
  c.c_address,
  c.c_phone,
  c.c_comment
FROM
  customer c,
  orders o,
  lineitem l,
  nation n
WHERE
  c.c_custkey = o.o_custkey AND l.l_orderkey = o.o_orderkey AND o.o_orderdate >= DATE '1994-03-01' AND o.o_orderdate < DATE '1994-06-01' AND l.l_returnflag = 'R' AND c.c_nationkey = n.n_nationkey
GROUP BY
  c.c_custkey, c.c_name, c.c_acctbal, c.c_phone, n.n_name, c.c_address, c.c_comment ORDER BY revenue DESC LIMIT 20;
