# gpu_execution - nested loop full outer join double inequality condition parquet
include ../../fixtures/migrated/tpch-parquet-original.slt

# Both WHERE predicates reject unmatched rows, so INNER JOIN preserves the CPU result.
onlyif duckdb
statement ok
CREATE TEMPORARY VIEW double_inequality_result AS
SELECT
  ps.ps_partkey,
  ps.ps_suppkey,
  l.l_orderkey
FROM
  lineitem l
  INNER JOIN partsupp ps ON l.l_partkey < ps.ps_partkey AND l.l_suppkey > ps.ps_suppkey
WHERE
  l.l_orderkey < 1000 AND ps.ps_partkey < 1000 ORDER BY ps.ps_partkey, ps.ps_suppkey, l.l_orderkey LIMIT 1000;

onlyif sirius
statement ok
CREATE TEMPORARY VIEW double_inequality_result AS
SELECT
  ps.ps_partkey,
  ps.ps_suppkey,
  l.l_orderkey
FROM
  lineitem l
  FULL JOIN partsupp ps ON l.l_partkey < ps.ps_partkey AND l.l_suppkey > ps.ps_suppkey
WHERE
  l.l_orderkey < 1000 AND ps.ps_partkey < 1000 ORDER BY ps.ps_partkey, ps.ps_suppkey, l.l_orderkey LIMIT 1000;

# Original query: test/cpp/integration/test_gpu_execution_tpch.cpp:2515
