statement ok
CREATE TABLE arr_multi_big (
  id INTEGER,
  a INTEGER[2],
  b DOUBLE[3]
);

statement ok
INSERT INTO arr_multi_big SELECT
  i,
  CASE
    WHEN i % 5 = 0 THEN
      NULL
    ELSE
      [i, i + 1]
  END,
  CASE
    WHEN i % 3 = 0 THEN
      NULL
    ELSE
      [i * 0.5, i * 0.25, i * 0.125]
  END
FROM
  range(5000) t (i);

statement ok
CHECKPOINT;

# Original query: test/cpp/integration/test_gpu_execution_array.cpp:281
