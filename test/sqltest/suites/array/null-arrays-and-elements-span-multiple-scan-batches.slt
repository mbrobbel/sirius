# gpu_execution array - NULL arrays and elements span multiple scan batches
# Preserve setup and query order from the C++ execution test.

statement ok
CREATE TABLE arr_null_big (
  id INTEGER,
  a INTEGER[3]
);

statement ok
INSERT INTO arr_null_big SELECT
  i,
  CASE
    WHEN i % 10 = 0 THEN
      NULL
    WHEN i % 7 = 0 THEN
      [NULL, i + 1, NULL]
    ELSE
      [i, i + 1, i + 2]
  END
FROM
  range(5000) t (i);

statement ok
CHECKPOINT;

