# gpu_execution array - join against a fully pruned ARRAY side
# Preserve setup and query order from the C++ execution test.

statement ok
CREATE TABLE arr_prune (
  id INTEGER,
  a INTEGER[3]
);

statement ok
INSERT INTO arr_prune SELECT
  i,
  [i, i + 1, i + 2]
FROM
  range(3000) t (i);

statement ok
CHECKPOINT;

statement ok
CREATE TABLE dim (
  id INTEGER
);

statement ok
INSERT INTO dim SELECT
  i
FROM
  range(100) t (i);

statement ok
CHECKPOINT;

statement ok
SET disabled_optimizers = concat_ws(',', nullif(current_setting('disabled_optimizers'), ''), 'statistics_propagation');

# Original query: test/cpp/integration/test_gpu_execution_array.cpp:558
# sirius: id = "array/join-against-a-fully-pruned-array-side/001"
# sirius: tags = ["integration", "array"]
query ?? rowsort
SELECT
  d.id,
  t.a
FROM
  dim d
  LEFT JOIN (SELECT * FROM arr_prune WHERE id >= 1000000) t USING(id);
