# gpu_execution array - compressed child data codecs (RLE/BitPacking/ALP)
# Preserve setup and query order from the C++ execution test.

statement ok
CREATE TEMPORARY TABLE codec_check (
  present BOOLEAN CHECK (present)
);

statement ok
SET force_compression = 'rle';

statement ok
CREATE TABLE arr_rle (
  id INTEGER,
  a INTEGER[3]
);

statement ok
INSERT INTO arr_rle SELECT
  i,
  [i // 100, i // 100, i // 100]
FROM
  range(5000) t (i);

statement ok
CHECKPOINT;

statement ok
RESET force_compression;

# Require the original compression premise.
statement count 1
INSERT INTO codec_check SELECT
  count(*) > 0
FROM
  pragma_storage_info('arr_rle')
WHERE
  column_name = 'a' AND compression = 'RLE';

