statement ok
SET force_compression = 'bitpacking';

statement ok
CREATE TABLE arr_bp (
  id INTEGER,
  a INTEGER[3]
);

statement ok
INSERT INTO arr_bp SELECT
  i,
  [i % 1000, (i * 2) % 1000, (i * 3) % 1000]
FROM
  range(5000) t (i);

statement ok
CHECKPOINT;

statement ok
RESET force_compression;

# Require the original compression premise.
statement count 1
INSERT INTO codec_check SELECT
  count(*) > 0
FROM
  pragma_storage_info('arr_bp')
WHERE
  column_name = 'a' AND compression = 'BitPacking';

