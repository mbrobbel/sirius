statement ok
CREATE TABLE arr_alp (
  id INTEGER,
  a FLOAT[3]
);

statement ok
INSERT INTO arr_alp SELECT
  i,
  [i * 0.5, i * 0.25, i * -0.125]::FLOAT[3]
FROM
  range(5000) t (i);

statement ok
CHECKPOINT;

# Require the original compression premise.
statement count 1
INSERT INTO codec_check SELECT
  count(*) > 0
FROM
  pragma_storage_info('arr_alp')
WHERE
  column_name = 'a' AND compression IN ('ALP', 'ALPRD');

