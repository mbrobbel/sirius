# gpu_execution array - array projected while a filter prunes a row group
# Preserve setup and query order from the C++ execution test.

statement ok
CREATE TABLE arr_prune (
  id INTEGER,
  a INTEGER[3]
);

statement ok
INSERT INTO arr_prune SELECT
  i,
  [i, i + 1, i + 2]
FROM
  range(200000) t (i);

statement ok
CHECKPOINT;

