query ??? nosort
SELECT
  probe.k,
  probe.v,
  build.v AS build_v
FROM
  read_parquet('__TEST_DIR__/probe/*.parquet') AS probe
  JOIN read_parquet('__TEST_DIR__/build/*.parquet') AS build ON probe.k = build.k
WHERE
  build.k % 2 = 0 ORDER BY probe.k, probe.v LIMIT 100;
