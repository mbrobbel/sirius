CREATE TABLE fixture_source AS SELECT range AS ps_partkey, (range % 50000) AS ps_suppkey, CAST(range AS DOUBLE) AS ps_supplycost, CAST(1 AS DOUBLE) AS ps_availqty FROM range(2000000);

