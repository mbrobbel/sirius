statement ok
CREATE TEMPORARY TABLE fixture_check (
  ok BOOLEAN NOT NULL CHECK (ok)
);

statement ok
COPY (SELECT DATE '1992-01-01' + CAST(range % 2557 AS INTEGER) AS d1, DATE '1992-01-01' + CAST(range % 2557 AS INTEGER) + CAST(range % 30 AS INTEGER) AS d2, CASE WHEN range % 7 = 0 THEN NULL ELSE DATE '1992-01-01' + CAST(range % 2557 AS INTEGER) END AS d3, range % 251 AS k FROM range(8192)) TO '__TEST_DIR__/date.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048);

statement ok
INSERT INTO fixture_check SELECT
  list(row_group_num_rows ORDER BY row_group_id) = [2048, 2048, 2048, 2048]
FROM
  (
    SELECT DISTINCT
      row_group_id,
      row_group_num_rows
    FROM
      parquet_metadata('__TEST_DIR__/date.parquet')
  );

statement ok
DROP TABLE fixture_check;

statement ok
CREATE VIEW t AS
SELECT
  *
FROM
  read_parquet('__TEST_DIR__/date.parquet');
