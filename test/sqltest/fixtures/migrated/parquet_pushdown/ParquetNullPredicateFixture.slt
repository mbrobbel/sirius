# Original fixture: ParquetNullPredicateFixture

statement ok
CREATE TABLE np (
  id INTEGER,
  v INTEGER,
  s VARCHAR,
  flag BOOLEAN,
  flag_dense BOOLEAN
);

statement ok
INSERT INTO np SELECT
  i,
  CASE
    WHEN i % 3 = 0 THEN
      NULL
    ELSE
      i
  END,
  CASE
    WHEN i % 4 = 0 THEN
      NULL
    ELSE
      'r' || CAST(i AS VARCHAR)
  END,
  CASE
    WHEN i % 2 = 0 THEN
      (i % 4 = 0)
  END,
  (i % 4 = 0)
FROM
  range(1, 6001) AS t (i);

statement ok
COPY np TO '__TEST_DIR__/null_pred.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048);

statement ok
CREATE TEMPORARY TABLE fixture_check (
  ok BOOLEAN NOT NULL CHECK (ok)
);

statement count 1
INSERT INTO fixture_check SELECT
  count(*) = 6000 AND count(v) = 4000
FROM
  read_parquet('__TEST_DIR__/null_pred.parquet');

statement count 1
INSERT INTO fixture_check SELECT
  count(s) = 4500 AND count(flag) = 3000 AND count(flag_dense) = 6000
FROM
  read_parquet('__TEST_DIR__/null_pred.parquet');

statement count 1
INSERT INTO fixture_check SELECT
  list(row_group_num_rows ORDER BY row_group_id) = [2048, 2048, 1904]
FROM
  (
    SELECT DISTINCT
      row_group_id,
      row_group_num_rows
    FROM
      parquet_metadata('__TEST_DIR__/null_pred.parquet')
  );

statement ok
DROP TABLE fixture_check;
