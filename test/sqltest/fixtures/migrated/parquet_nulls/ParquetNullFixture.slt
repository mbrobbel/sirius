# Original fixture: ParquetNullFixture

statement ok
CREATE TEMPORARY TABLE fixture_check (
  ok BOOLEAN NOT NULL CHECK (ok)
);

statement ok
CREATE TABLE nt (
  id INTEGER,
  n_int INTEGER,
  n_big BIGINT,
  n_dbl DOUBLE,
  n_flt FLOAT,
  n_dec32 DECIMAL(9,2),
  n_dec64 DECIMAL(18,2),
  n_date DATE,
  n_ts TIMESTAMP,
  n_bool BOOLEAN,
  n_str VARCHAR,
  p_int INTEGER,
  p_big BIGINT,
  p_dbl DOUBLE,
  p_flt FLOAT,
  p_dec32 DECIMAL(9,2),
  p_dec64 DECIMAL(18,2),
  p_date DATE,
  p_ts TIMESTAMP,
  p_bool BOOLEAN,
  p_str VARCHAR
);

statement ok
INSERT INTO nt SELECT
  i,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  CASE
    WHEN i % 2 = 0 THEN
      i
  END,
  CASE
    WHEN i % 2 = 0 THEN
      i * 1000
  END,
  CASE
    WHEN i % 2 = 0 THEN
      i * 1.5
  END,
  CASE
    WHEN i % 2 = 0 THEN
      i * 0.25
  END,
  CASE
    WHEN i % 2 = 0 THEN
      i
  END,
  CASE
    WHEN i % 2 = 0 THEN
      i
  END,
  CASE
    WHEN i % 2 = 0 THEN
      DATE '2021-01-01' + CAST(i AS INTEGER)
  END,
  CASE
    WHEN i % 2 = 0 THEN
      TIMESTAMP '2021-01-01 00:00:00' + INTERVAL (i) HOUR
  END,
  CASE
    WHEN i % 2 = 0 THEN
      (i % 4 = 0)
  END,
  CASE
    WHEN i % 2 = 0 THEN
      'v' || CAST(i AS VARCHAR)
  END
FROM
  range(1, 17) AS t (i);

statement ok
COPY nt TO '__TEST_DIR__/nulls.parquet' (FORMAT PARQUET);

