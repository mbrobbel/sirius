COPY (SELECT 'a-' || i AS a, 'b-' || i AS b FROM range(257) t (i)) TO '__TEST_DIR__/strings.parquet' (FORMAT PARQUET);

statement ok
COPY (SELECT CASE WHEN i % 4 = 0 THEN NULL::BIGINT ELSE i END AS id, NULL::BOOLEAN AS flag FROM range(257) t (i)) TO '__TEST_DIR__/null_carrier.parquet' (FORMAT PARQUET);

