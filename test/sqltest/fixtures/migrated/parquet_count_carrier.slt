COPY (SELECT i::BIGINT AS id, (i * 0.25)::DOUBLE AS amount, ('label-' || i)::VARCHAR AS label, (i % 100)::SMALLINT AS small, DATE '2024-01-01' + i::INTEGER AS day, CASE WHEN i % 3 = 0 THEN NULL::BOOLEAN ELSE i % 2 = 0 END AS flag FROM range(257) t (i)) TO '__TEST_DIR__/flat.parquet' (FORMAT PARQUET);

