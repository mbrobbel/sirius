statement ok
CHECKPOINT;

statement ok
COPY (SELECT * FROM t WHERE d IS NOT NULL) TO '__TEST_DIR__/t.parquet' (FORMAT PARQUET);

statement ok
CREATE VIEW p_t AS
SELECT
  *
FROM
  read_parquet('__TEST_DIR__/t.parquet');

statement ok
COPY (SELECT line FROM (VALUES (1, 'input -> bitpack -> chunk_min, chunk_count, chunk_bits, packed'), (2, '---'), (3, 'input -> bitpack -> chunk_min, chunk_count, chunk_bits, packed')) AS plan (position, line) ORDER BY position) TO '__TEST_DIR__/p_t.txt' (FORMAT CSV, HEADER FALSE, DELIMITER '|');

