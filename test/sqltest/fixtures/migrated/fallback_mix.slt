statement ok
COPY (SELECT CAST(i - 100 AS BIGINT) AS id, CAST(i - 100 AS BIGINT) AS a, CAST(i AS BIGINT) AS b, CASE WHEN i % 7 = 0 THEN NULL ELSE CAST(i - 100 AS BIGINT) END AS x, struct_pack(a := i, b := i * 10) AS st, [i, i + 1] AS li, MAP([1, 2], [i, i + 1]) AS mp FROM range(300) t (i)) TO '__TEST_DIR__/nested.parquet' (FORMAT PARQUET);

statement ok
COPY (SELECT * FROM (SELECT CAST(i - 100 AS BIGINT) AS id, CAST(i - 100 AS BIGINT) AS a, CAST(i AS BIGINT) AS b, CASE WHEN i % 7 = 0 THEN NULL ELSE CAST(i - 100 AS BIGINT) END AS x, struct_pack(a := i, b := i * 10) AS st, [i, i + 1] AS li, MAP([1, 2], [i, i + 1]) AS mp FROM range(300) t (i)) empty_source WHERE false) TO '__TEST_DIR__/empty.parquet' (FORMAT PARQUET);

statement ok
CREATE TABLE mix_native AS SELECT CAST(i - 100 AS BIGINT) AS id, CAST(i - 100 AS BIGINT) AS a, CAST(i AS BIGINT) AS b, CASE WHEN i % 7 = 0 THEN NULL ELSE CAST(i - 100 AS BIGINT) END AS x, struct_pack(a := i, b := i * 10) AS st, [i, i + 1] AS li, MAP([1, 2], [i, i + 1]) AS mp FROM range(300) t (i);

statement ok
CHECKPOINT;

statement ok
COPY (SELECT * FROM read_parquet('__TEST_DIR__/nested.parquet')) TO '__TEST_DIR__/hive/part=1/data.parquet' (FORMAT PARQUET);
