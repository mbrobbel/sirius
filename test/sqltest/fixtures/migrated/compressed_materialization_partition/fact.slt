statement ok
COPY (SELECT range % 50000 AS k, (range * 11) % 297 AS v, CAST(((range * 13) % 29000) / 100.0 AS DECIMAL(18,2)) AS d FROM range(200000)) TO '__TEST_DIR__/fact.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 30720);

statement ok
CREATE TEMPORARY TABLE fixture_check (
  ok BOOLEAN NOT NULL CHECK (ok)
);

statement ok
INSERT INTO fixture_check SELECT
  list(row_group_num_rows ORDER BY row_group_id) = [30720, 30720, 30720, 30720, 30720, 30720, 15680]
FROM
  (
    SELECT DISTINCT
      row_group_id,
      row_group_num_rows
    FROM
      parquet_metadata('__TEST_DIR__/fact.parquet')
  );

statement ok
DROP TABLE fixture_check;

statement ok
CREATE VIEW t AS
SELECT
  *
FROM
  read_parquet('__TEST_DIR__/fact.parquet');
