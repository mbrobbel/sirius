statement ok
COPY (SELECT range AS k, range % 100 AS x FROM range(50000)) TO '__TEST_DIR__/dim.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 10240);

statement ok
CREATE TEMPORARY TABLE fixture_check (
  ok BOOLEAN NOT NULL CHECK (ok)
);

statement ok
INSERT INTO fixture_check SELECT
  list(row_group_num_rows ORDER BY row_group_id) = [10240, 10240, 10240, 10240, 9040]
FROM
  (
    SELECT DISTINCT
      row_group_id,
      row_group_num_rows
    FROM
      parquet_metadata('__TEST_DIR__/dim.parquet')
  );

statement ok
DROP TABLE fixture_check;

statement ok
CREATE VIEW dm AS
SELECT
  *
FROM
  read_parquet('__TEST_DIR__/dim.parquet');
