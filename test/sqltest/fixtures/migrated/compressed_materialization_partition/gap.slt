statement ok
COPY (SELECT CASE WHEN range < 4096 THEN range ELSE range + 100000 END AS k, (range * 11) % 297 AS v FROM range(8192)) TO '__TEST_DIR__/gap.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048);

statement ok
CREATE TEMPORARY TABLE fixture_check (
  ok BOOLEAN NOT NULL CHECK (ok)
);

statement ok
INSERT INTO fixture_check SELECT
  list(row_group_num_rows ORDER BY row_group_id) = [2048, 2048, 2048, 2048]
FROM
  (
    SELECT DISTINCT
      row_group_id,
      row_group_num_rows
    FROM
      parquet_metadata('__TEST_DIR__/gap.parquet')
  );

statement ok
DROP TABLE fixture_check;

statement ok
CREATE VIEW g AS
SELECT
  *
FROM
  read_parquet('__TEST_DIR__/gap.parquet');
