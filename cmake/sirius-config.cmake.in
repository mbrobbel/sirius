@PACKAGE_INIT@

set(sirius_shared_FOUND FALSE)
set(sirius_static_FOUND FALSE)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/sirius-targets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/sirius-targets.cmake")
  set(sirius_shared_FOUND TRUE)
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/sirius-static-targets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/sirius-static-targets.cmake")
  set(sirius_static_FOUND TRUE)
  if(NOT TARGET sirius::sirius)
    add_library(sirius::sirius INTERFACE IMPORTED)
    set_target_properties(sirius::sirius PROPERTIES
                          INTERFACE_LINK_LIBRARIES sirius::sirius_static)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/sirius-duckdb-compatibility.cmake")
if(NOT TARGET sirius::sirius)
  set(sirius_FOUND FALSE)
  set(sirius_NOT_FOUND_MESSAGE "Install a Sirius shared or static library package")
endif()
check_required_components(sirius)
