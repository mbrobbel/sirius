if(TARGET sirius::sirius_static)
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/libsirius.a.cmake")
# The compiler driver supplies these runtimes with static linkage below.
list(REMOVE_ITEM SIRIUS_STATIC_SYSTEM_LIBRARIES gcc_s stdc++)
if("cuda" IN_LIST SIRIUS_STATIC_SYSTEM_LIBRARIES OR
   "nvidia-ml" IN_LIST SIRIUS_STATIC_SYSTEM_LIBRARIES)
  include(CMakeFindDependencyMacro)
  find_dependency(CUDAToolkit)
  list(TRANSFORM SIRIUS_STATIC_SYSTEM_LIBRARIES REPLACE "^cuda$" "CUDA::cuda_driver")
  list(TRANSFORM SIRIUS_STATIC_SYSTEM_LIBRARIES REPLACE "^nvidia-ml$" "CUDA::nvml")
endif()
set(_sirius_static_archive
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libsirius.a")
set(_sirius_nvtx_directory "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/sirius-static")
# Link the existing NVTX object directly so archive-hiding flags cannot hide
# the entry point that NVTX discovers through dlsym.
file(ARCHIVE_EXTRACT INPUT "${_sirius_static_archive}"
     DESTINATION "${_sirius_nvtx_directory}" PATTERNS "nvtx_injection.cpp.o")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
             "${_sirius_static_archive}")
add_library(sirius::sirius_static_archive STATIC IMPORTED)
set_target_properties(sirius::sirius_static_archive PROPERTIES
  IMPORTED_LOCATION "${_sirius_static_archive}")
add_library(sirius::sirius_static INTERFACE IMPORTED)
set_target_properties(sirius::sirius_static PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
  INTERFACE_SOURCES "${_sirius_nvtx_directory}/nvtx_injection.cpp.o"
  INTERFACE_COMPILE_FEATURES cxx_std_20
  INTERFACE_LINK_LIBRARIES "sirius::sirius_static_archive;${SIRIUS_STATIC_SYSTEM_LIBRARIES}"
  INTERFACE_LINK_OPTIONS "-static-libgcc;-static-libstdc++;LINKER:--allow-multiple-definition;LINKER:--undefined=InitializeInjectionNvtx2;LINKER:--export-dynamic-symbol=InitializeInjectionNvtx2;LINKER:--export-dynamic-symbol=dlopen")

if("@VCPKG_BUILD@" AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set_property(TARGET sirius::sirius_static APPEND PROPERTY
    INTERFACE_LINK_OPTIONS "LINKER:-T,${CMAKE_CURRENT_LIST_DIR}/sirius-cuda-fatbin.ld")
  set_property(TARGET sirius::sirius_static APPEND PROPERTY
    INTERFACE_LINK_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/sirius-cuda-fatbin.ld")
endif()
