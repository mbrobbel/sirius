if(TARGET sirius::sirius_static)
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/libsirius.a.cmake")
if("cuda" IN_LIST SIRIUS_STATIC_SYSTEM_LIBRARIES OR
   "nvidia-ml" IN_LIST SIRIUS_STATIC_SYSTEM_LIBRARIES)
  include(CMakeFindDependencyMacro)
  find_dependency(CUDAToolkit)
  list(TRANSFORM SIRIUS_STATIC_SYSTEM_LIBRARIES REPLACE "^cuda$" "CUDA::cuda_driver")
  list(TRANSFORM SIRIUS_STATIC_SYSTEM_LIBRARIES REPLACE "^nvidia-ml$" "CUDA::nvml")
endif()
add_library(sirius::sirius_static_archive STATIC IMPORTED)
set_target_properties(sirius::sirius_static_archive PROPERTIES
  IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libsirius.a")
add_library(sirius::sirius_static INTERFACE IMPORTED)
set_target_properties(sirius::sirius_static PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
  INTERFACE_COMPILE_FEATURES cxx_std_20
  INTERFACE_LINK_LIBRARIES "sirius::sirius_static_archive;${SIRIUS_STATIC_SYSTEM_LIBRARIES}"
  INTERFACE_LINK_OPTIONS "LINKER:--allow-multiple-definition;LINKER:--undefined=InitializeInjectionNvtx2;LINKER:--export-dynamic-symbol=InitializeInjectionNvtx2;LINKER:--export-dynamic-symbol=dlopen")

if("@VCPKG_BUILD@" AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set_property(TARGET sirius::sirius_static APPEND PROPERTY
    INTERFACE_LINK_OPTIONS "LINKER:-T,${CMAKE_CURRENT_LIST_DIR}/sirius-cuda-fatbin.ld")
  set_property(TARGET sirius::sirius_static APPEND PROPERTY
    INTERFACE_LINK_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/sirius-cuda-fatbin.ld")
endif()
